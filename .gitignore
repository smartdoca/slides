# Dependencies and generated build output
node_modules/
dist/
*.tsbuildinfo

# Locally packed npm archives; do not hide archives used as test fixtures
/*.tgz
/artifacts/*.tgz
# Disposable QA output only. Keep artifacts/RELEASE.md and acceptance screenshots.
/artifacts/tmp/
/artifacts/cache/
/artifacts/test-results/

# Local demo documents and SQLite journal files (never commit user data)
.demo-data/
# SQLite sidecars are runtime state, never source or portable fixtures
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Environment secrets; keep shareable templates
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
!.env.*.sample
!.env.*.template

# Test reports and tool caches
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.cache/
.vite/
.vite-temp/
.vitest/
.npm/
.yarn-cache/
.eslintcache
.stylelintcache

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo
*.orig
*.rej
*~
/tmp/
/temp/

# OS and local editor files
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
