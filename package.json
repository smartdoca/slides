{
  "name": "@smartdoca/slides",
  "version": "0.3.0-alpha.1",
  "description": "Embeddable React presentation editor with Leafer, Slate and Yjs",
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "dist",
    "docs",
    "examples",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./collaboration": {
      "types": "./dist/collaboration/index.d.ts",
      "import": "./dist/collaboration/index.js",
      "require": "./dist/collaboration/index.cjs"
    },
    "./pptx": {
      "types": "./dist/pptx.d.ts",
      "import": "./dist/pptx.js",
      "require": "./dist/pptx.cjs"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/core.ts src/pptx.ts src/collaboration/index.ts --clean --format esm,cjs --dts --external react --external react-dom && cp src/react/styles.css dist/styles.css",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@antv/g-svg": "^2.1.1",
    "@antv/g2": "5.4.8",
    "@leafer-in/editor": "^2.2.0",
    "@leafer-in/export": "^2.2.0",
    "@leafer-in/interface": "^2.2.0",
    "@leafer-in/resize": "^2.2.0",
    "@leafer-ui/core": "^2.2.0",
    "@leafer-ui/draw": "^2.2.0",
    "@leafer-ui/interface": "^2.2.0",
    "@leafer/interface": "^2.2.0",
    "@slate-yjs/core": "^1.0.2",
    "fast-xml-parser": "^5.3.0",
    "jszip": "^3.10.1",
    "leafer-ui": "^2.2.0",
    "pptxgenjs": "^4.0.1",
    "slate": "^0.118.0",
    "slate-dom": "^0.118.0",
    "slate-react": "^0.118.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "ws": "^8.18.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartdoca/slides.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
